    <!-- Full device-transfer backups -->
    <string name="backup_description">Save all records and continue on another phone</string>
    <string name="backup_instructions">Export a full CSV or Excel backup, then create or sign in to a profile on the other phone and restore it here. Includes all financial records, archived and deleted items, receipts, display name, theme, and language. Login credentials, app lock, and AI keys stay on each device. Keep the original file unchanged and private. Up to 8 MB of receipts and 32 MB of backup content are supported.</string>
    <string name="backup_export_csv">Export full backup (CSV)</string>
    <string name="backup_export_excel">Export full backup (Excel .xlsx)</string>
    <string name="backup_import">Choose backup to restore</string>
    <string name="backup_restore_title">Restore this backup?</string>
    <string name="backup_preview">%1$s • %2$s\n%3$d accounts • %4$d transactions\n%5$d categories • %6$d budgets\n%7$d savings goals • %8$d receipts</string>
    <string name="backup_replace_warning">This replaces all financial records in the currently signed-in profile, including archived items and the recycle bin. Other profiles are kept. Export your current data first if you want to keep it.</string>
    <string name="backup_replace_confirm">Replace and restore</string>
    <string name="backup_working">Processing backup. Please keep the app open.</string>
    <string name="backup_export_success">Backup saved. Copy this file to the other phone and restore it from Settings → Backup &amp; Restore.</string>
    <string name="backup_restore_success">Backup restored. Your balances and records are ready to use.</string>
    <string name="backup_export_error">Backup could not be saved. Check free storage, file access, and that all receipt files are available. Large backups may exceed the supported limit. Try again with a new file.</string>
    <string name="backup_read_error">This file could not be read as a complete supported backup. Choose an unchanged full backup exported from Settings. Edited, incomplete, oversized, or report-only files cannot be restored.</string>
    <string name="backup_restore_error">Restore could not be completed. Your existing financial records were kept. Check available storage and try again.</string>
    <string name="backup_preferences_error">All financial records were restored, but theme and language could not be applied. Set them in Settings.</string>
